{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PhotonPower/Raytatouille/schema/raytatouille-coatings.schema.json",
  "title": "Raytatouille coating catalogue (ADR 0019), format version 0.1",
  "description": "Coating designs referenced from system files as CATALOG:NAME. Thicknesses and wavelengths in um. Layers from the ambient side to the substrate. Parsing in rtt-coating (CoatingLibrary::add_catalog) is the reference; this schema must accept exactly what it accepts structurally.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "catalog", "coatings"],
  "properties": {
    "format": {"const": "raytatouille-coatings"},
    "schema_version": {"const": "0.1.0"},
    "catalog": {"$ref": "#/$defs/name"},
    "coatings": {"type": "array", "items": {"$ref": "#/$defs/coating"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[^:]+$"},
    "coating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "layers"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string"},
        "design_wavelength_um": {"type": "number", "exclusiveMinimum": 0},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}
      },
      "if": {"properties": {"layers": {"contains": {"required": ["qwot"]}}}},
      "then": {"required": ["design_wavelength_um"]}
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material"],
      "properties": {
        "material": {"type": "string", "minLength": 1},
        "thickness_um": {"type": "number", "minimum": 0},
        "qwot": {"type": "number", "minimum": 0}
      },
      "oneOf": [{"required": ["thickness_um"]}, {"required": ["qwot"]}]
    }
  }
}
