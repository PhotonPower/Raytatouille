{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PhotonPower/Raytatouille/schema/raytatouille.schema.json",
  "title": "Raytatouille system file (.rtt.json), schema 0.4",
  "description": "Units: lengths mm, wavelengths um, angles in degree where the key ends in _deg. Parsing in rtt-io is the reference; this schema must accept exactly what rtt-io accepts structurally for the current schema version. rtt-io migrates older files (0.1, 0.2, 0.3); run rtt format before checking them against this schema. Semantic rules (names of parameter rows, one value per configuration, bounds) are checked by validate, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units", "wavelengths", "aperture", "fields", "root", "paths"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.4\\.[0-9]+$"},
    "name": {"type": "string"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "wavelength"],
      "properties": {"length": {"const": "mm"}, "wavelength": {"const": "um"}}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature_c": {"type": "number"},
        "pressure_atm": {"type": "number"},
        "medium": {"type": "string"}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_infinity"],
      "properties": {"at_infinity": {"type": "boolean"}, "distance": {"$ref": "#/$defs/param"}}
    },
    "wavelengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["um"],
        "properties": {
          "um": {"type": "number"},
          "weight": {"type": "number", "minimum": 0},
          "reference": {"type": "boolean"}
        }
      }
    },
    "aperture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["epd", "image_fnumber", "object_na", "stop_size"]},
        "value": {"$ref": "#/$defs/param"}
      },
      "if": {"properties": {"type": {"not": {"const": "stop_size"}}}},
      "then": {"required": ["value"]}
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "type": {"enum": ["angle_deg", "object_height", "paraxial_image_height"]},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "weight": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "configurations": {
      "description": "Configurations (ADR 0029): columns of the parameter table. Omitted for only the nominal configuration; never empty.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string"}}
      }
    },
    "parameters": {
      "description": "Parameter table (ADR 0029) in evaluation order.",
      "type": "array",
      "items": {"$ref": "#/$defs/parameter_row"}
    },
    "root": {"$ref": "#/$defs/assembly"},
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "optimization": {
      "description": "Merit function (ADR 0030): operands and generators. Omitted without a merit function. Paths, configurations, parameter rows and surfaces are named; field and wavelength are indices into fields.points and wavelengths (missing wavelength: the reference wavelength). The names and the index ranges are checked by validate (merit.*), not here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operands": {"type": "array", "items": {"$ref": "#/$defs/operand"}},
        "generators": {"type": "array", "items": {"$ref": "#/$defs/generator"}}
      }
    }
  },
  "$defs": {
    "index": {"type": "integer", "minimum": 0, "maximum": 65535},
    "selection": {
      "description": "Field or wavelength indices of a generator; omitted for all (with their weights); never empty.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/index"}
    },
    "operand": {
      "description": "One operand (ADR 0030, points 1 and 3): residual sqrt(weight) (value - target). target is required; weight defaults to 1; configuration names a configuration (missing: configuration 0).",
      "type": "object",
      "required": ["type", "target"],
      "oneOf": [
        {
          "description": "Paraxial quantity of a path: efl and bfl in mm, image_fnumber and magnification dimensionless.",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "type": {"enum": ["efl", "bfl", "image_fnumber", "magnification"]},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "wavelength": {"$ref": "#/$defs/index"},
            "target": {"type": "number"},
            "weight": {"type": "number"}
          }
        },
        {
          "description": "x or y of a real ray in mm in the local coordinates of a surface of the path. occurrence (0-based) picks the event if the path meets the surface more than once. px, py: normalised pupil coordinates as in make_rays (unit circle = rim of the paraxial entrance pupil, +y meridional), default 0.",
          "additionalProperties": false,
          "required": ["path", "surface"],
          "properties": {
            "type": {"enum": ["ray_x", "ray_y"]},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "surface": {"type": "string"},
            "occurrence": {"type": "integer", "minimum": 0},
            "field": {"$ref": "#/$defs/index"},
            "px": {"type": "number"},
            "py": {"type": "number"},
            "wavelength": {"$ref": "#/$defs/index"},
            "target": {"type": "number"},
            "weight": {"type": "number"}
          }
        },
        {
          "description": "RMS spot radius of one field in mm, hexapolar pupil with rings (default 6), about the centroid (default) or the chief ray; polychromatic: all wavelengths with their weights, then without wavelength.",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "type": {"const": "spot_rms"},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "field": {"$ref": "#/$defs/index"},
            "wavelength": {"$ref": "#/$defs/index"},
            "polychromatic": {"type": "boolean"},
            "reference": {"enum": ["centroid", "chief"]},
            "rings": {"type": "integer"},
            "target": {"type": "number"},
            "weight": {"type": "number"}
          },
          "if": {"required": ["polychromatic"], "properties": {"polychromatic": {"const": true}}},
          "then": {"properties": {"wavelength": false}}
        },
        {
          "description": "RMS wavefront error of one field in waves, pupil grid of grid x grid points (default 33).",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "type": {"const": "opd_rms"},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "field": {"$ref": "#/$defs/index"},
            "wavelength": {"$ref": "#/$defs/index"},
            "grid": {"type": "integer"},
            "target": {"type": "number"},
            "weight": {"type": "number"}
          }
        },
        {
          "description": "Value of a row of the parameter table in a configuration, unit of the row.",
          "additionalProperties": false,
          "required": ["parameter"],
          "properties": {
            "type": {"const": "param_value"},
            "parameter": {"type": "string"},
            "configuration": {"type": "string"},
            "target": {"type": "number"},
            "weight": {"type": "number"}
          }
        }
      ]
    },
    "generator": {
      "description": "Generator (ADR 0030, point 4): residuals per ray with Gaussian quadrature in the pupil, rings (default 3) in rho^2 and arms (default 6) per ring; target 0, no target key.",
      "type": "object",
      "required": ["type", "path"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {"const": "rms_spot"},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "fields": {"$ref": "#/$defs/selection"},
            "wavelengths": {"$ref": "#/$defs/selection"},
            "reference": {"enum": ["centroid", "chief"]},
            "rings": {"type": "integer"},
            "arms": {"type": "integer"},
            "weight": {"type": "number"}
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {"const": "rms_wavefront"},
            "path": {"type": "string"},
            "configuration": {"type": "string"},
            "fields": {"$ref": "#/$defs/selection"},
            "wavelengths": {"$ref": "#/$defs/selection"},
            "rings": {"type": "integer"},
            "arms": {"type": "integer"},
            "weight": {"type": "number"}
          }
        }
      ]
    },
    "param": {
      "description": "A number, a value with optimizer flags and bounds, or a reference to a row of the parameter table without a value of its own (ADR 0029).",
      "oneOf": [
        {"type": "number"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {"type": "number"},
            "variable": {"type": "boolean"},
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["param"],
          "properties": {"param": {"type": "string"}}
        }
      ]
    },
    "parameter_row": {
      "description": "A name and exactly one of value (all configurations), values (one per configuration) and expression (earlier rows); bounds only with value or values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": "number"},
        "values": {"type": "array", "items": {"type": "number"}},
        "expression": {"type": "string"},
        "variable": {"type": "boolean"},
        "min": {"type": "number"},
        "max": {"type": "number"}
      },
      "oneOf": [{"required": ["value"]}, {"required": ["values"]}, {"required": ["expression"]}],
      "if": {"required": ["expression"]},
      "then": {"properties": {"min": false, "max": false}}
    },
    "param_list": {"type": "array", "items": {"$ref": "#/$defs/param"}},
    "param3": {"type": "array", "items": {"$ref": "#/$defs/param"}, "minItems": 3, "maxItems": 3},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {"enum": ["absolute", "relative_to_preceding", "relative_to_sibling"]},
        "order": {"enum": ["translate_first", "rotate_first"]},
        "position": {"$ref": "#/$defs/param3"},
        "rotation_deg": {"$ref": "#/$defs/param3"},
        "pivot": {"$ref": "#/$defs/vec3"}
      }
    },
    "node": {
      "oneOf": [{"$ref": "#/$defs/assembly"}, {"$ref": "#/$defs/element"}]
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "children"],
      "properties": {
        "type": {"const": "assembly"},
        "name": {"type": "string"},
        "pose": {"$ref": "#/$defs/pose"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "surfaces"],
      "properties": {
        "type": {"enum": ["lens", "mirror", "plate", "thin_element", "stop", "detector"]},
        "name": {"type": "string"},
        "pose": {"$ref": "#/$defs/pose"},
        "material": {"$ref": "#/$defs/material"},
        "optic_axis": {
          "description": "Optic axis of a crystal (ADR 0026) in element coordinates, dimensionless, not normalised; required exactly for a crystal material (checked by rtt validate).",
          "$ref": "#/$defs/vec3"
        },
        "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}}
      }
    },
    "material": {
      "description": "Catalog reference CATALOG:NAME. A string is one material for all segments; an array has one entry per segment (segment i between surfaces i and i+1, N surfaces give N-1 entries, lens and plate only; counts are checked by rtt validate). An object is a uniaxial crystal for all segments (ADR 0026): ordinary and extraordinary reference the principal indices n_O and n_E; lens and plate only, with optic_axis.",
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinary", "extraordinary"],
          "properties": {
            "ordinary": {"type": "string"},
            "extraordinary": {"type": "string"}
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "pose": {"$ref": "#/$defs/pose"},
        "shape": {"$ref": "#/$defs/shape"},
        "aperture": {"$ref": "#/$defs/aperture"},
        "phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}},
        "diffraction_efficiency": {
          "description": "Power fraction per diffraction order (ADR 0025); orders not listed have efficiency 0. A non-empty list at a surface with phases, efficiencies in [0, 1], each order once: checked by rtt validate.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "efficiency"],
            "properties": {
              "order": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
              "efficiency": {"type": "number"}
            }
          }
        },
        "interaction": {"$ref": "#/$defs/interaction"}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {"$ref": "#/$defs/base_shape"},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/shape_term"}}
      }
    },
    "base_shape": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {"type": {"const": "plane"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": {
            "type": {"const": "conic"},
            "radius": {"$ref": "#/$defs/param"},
            "conic": {"$ref": "#/$defs/param"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": {
            "type": {"const": "even_asphere"},
            "radius": {"$ref": "#/$defs/param"},
            "conic": {"$ref": "#/$defs/param"},
            "coefficients": {"$ref": "#/$defs/param_list"}
          }
        }
      ]
    },
    "shape_term": {
      "type": "object", "additionalProperties": false, "required": ["type", "normalization_radius"],
      "properties": {
        "type": {"const": "zernike_sag"},
        "normalization_radius": {"$ref": "#/$defs/param"},
        "coefficients": {"$ref": "#/$defs/param_list"}
      }
    },
    "aperture": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": {
            "type": {"const": "circular"},
            "radius": {"type": "number"},
            "inner_radius": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "half_width_x", "half_width_y"],
          "properties": {
            "type": {"const": "rectangular"},
            "half_width_x": {"type": "number"},
            "half_width_y": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "semi_axis_x", "semi_axis_y"],
          "properties": {
            "type": {"const": "elliptical"},
            "semi_axis_x": {"type": "number"},
            "semi_axis_y": {"type": "number"}
          }
        }
      ]
    },
    "phase": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "lines_per_mm"],
          "description": "Straight-line grating (ADR 0025): phi = 2 pi G (x cos psi + y sin psi) in rad over the local surface coordinates; lines_per_mm G in 1/mm, orientation_deg psi from the local x axis towards the local y axis; psi = 0 puts the grooves parallel to the local y axis.",
          "properties": {
            "type": {"const": "linear_grating"},
            "lines_per_mm": {"$ref": "#/$defs/param"},
            "orientation_deg": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "normalization_radius"],
          "description": "Rotationally symmetric phase (ADR 0025): phi = sum_k c_k rho^(2k), rho = r / normalization_radius; normalization_radius in mm, coefficients c_1, c_2, ... in rad (not in waves, no factor 2 pi), the first for rho^2. The values hold unchanged for every wavelength.",
          "properties": {
            "type": {"const": "radial_phase"},
            "normalization_radius": {"$ref": "#/$defs/param"},
            "coefficients": {"$ref": "#/$defs/param_list"}
          }
        }
      ]
    },
    "interaction": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {"type": {"enum": ["fresnel", "ideal_mirror", "ideal_anti_reflection", "absorber"]}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"const": "ideal_beam_splitter"},
            "reflectance_s": {"type": "number"},
            "reflectance_p": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "name"],
          "properties": {"type": {"const": "coating"}, "name": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"const": "ideal_polarizer"},
            "transmission_axis": {"$ref": "#/$defs/vec3"},
            "extinction_ratio": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"const": "ideal_retarder"},
            "fast_axis": {"$ref": "#/$defs/vec3"},
            "retardance_waves": {"type": "number"}
          }
        }
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "events"],
      "properties": {
        "name": {"type": "string"},
        "events": {
          "oneOf": [
            {"const": "auto"},
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["surface"],
                "properties": {
                  "surface": {"type": "string"},
                  "kind": {"enum": ["refract", "reflect", "transmit", "ordinary", "extraordinary"]},
                  "order": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
                }
              }
            }
          ]
        }
      }
    }
  }
}
