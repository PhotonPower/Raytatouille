{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "RTT_BUILD_TESTS": "ON" }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "dev",
      "displayName": "Development (system packages, Ninja, Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ci-linux-gcc",
      "inherits": ["base", "vcpkg"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "RTT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-linux-clang",
      "inherits": ["base", "vcpkg"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "RTT_WARNINGS_AS_ERRORS": "ON",
        "RTT_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "ci-linux-sanitizers",
      "inherits": ["base", "vcpkg"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "RTT_WARNINGS_AS_ERRORS": "ON",
        "RTT_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci-windows-msvc",
      "inherits": ["base", "vcpkg"],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": { "RTT_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "ci-linux-python",
      "displayName": "Python package with tests (GCC; Python from PATH or Python_ROOT_DIR)",
      "inherits": "ci-linux-gcc",
      "cacheVariables": { "RTT_BUILD_PYTHON": "ON", "RTT_BUILD_APPS": "OFF" }
    },
    {
      "name": "ci-windows-python",
      "displayName": "Python package with tests (MSVC; Python from PATH or Python_ROOT_DIR)",
      "inherits": "ci-windows-msvc",
      "cacheVariables": { "RTT_BUILD_PYTHON": "ON", "RTT_BUILD_APPS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci-linux-gcc", "configurePreset": "ci-linux-gcc" },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang" },
    { "name": "ci-linux-sanitizers", "configurePreset": "ci-linux-sanitizers" },
    { "name": "ci-windows-msvc", "configurePreset": "ci-windows-msvc", "configuration": "Release" },
    { "name": "ci-linux-python", "configurePreset": "ci-linux-python" },
    { "name": "ci-windows-python", "configurePreset": "ci-windows-python", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "ci-linux-gcc", "configurePreset": "ci-linux-gcc", "output": { "outputOnFailure": true } },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang", "output": { "outputOnFailure": true } },
    { "name": "ci-linux-sanitizers", "configurePreset": "ci-linux-sanitizers", "output": { "outputOnFailure": true } },
    { "name": "ci-windows-msvc", "configurePreset": "ci-windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ci-linux-python", "configurePreset": "ci-linux-python", "output": { "outputOnFailure": true } },
    { "name": "ci-windows-python", "configurePreset": "ci-windows-python", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
