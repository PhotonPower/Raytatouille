            "aperture": {"type": "circular", "radius": 5.0}
          }
        ]
      },
      {
        "type": "lens",
        "name": "L1",
        "pose": {"position": [0.0, 0.0, 5.0]},
        "material": "CONST:1.5168",
        "surfaces": [
          {
            "id": "L1.S1",
            "shape": {
              "base": {"type": "conic", "radius": {"param": "R1"}}
            },
            "aperture": {"type": "circular", "radius": 12.7}
          },
          {
            "id": "L1.S2",
            "pose": {"position": [0.0, 0.0, 4.0]},
            "shape": {
              "base": {"type": "conic", "radius": {"param": "R2"}}
            },
            "aperture": {"type": "circular", "radius": 12.7}
          }
        ]
      },
      {
        "type": "detector",
