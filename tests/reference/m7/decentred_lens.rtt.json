      {
        "id": "lens-dy",
        "node": "lens",
        "kind": "decenter_y",
        "limit": 0.1,
        "distribution": "uniform"
      }
    ],
    "criteria": [
      {
        "id": "image-y",
        "operand": {"type": "ray_y", "path": "main", "surface": "IMG"},
        "max_change": 0.05
      },
      {
        "id": "efl",
        "operand": {"type": "efl", "path": "main"},
        "max_change": 0.5
      }
    ],
    "monte_carlo": {"seed": 262, "trials": 200}
  }
